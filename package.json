{
  "name": "camcue",
  "version": "0.0.1",
  "private": true,
  "description": "CamCue(캠큐) — 교회 예배 라이브 중계용 카메라 큐 진행 + ATEM 제어 + 카메라맨 폰 CueScreen",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "node scripts/ensure-env.mjs && prisma generate && prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "package": "node scripts/package.mjs",
    "version": "tsx scripts/changelog.ts release && git add CHANGELOG.md",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "preversion": "tsx scripts/changelog.ts check && npm test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@prisma/client": "^6.19.3",
    "atem-connection": "^3.10.3",
    "fastify": "^5.12.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
