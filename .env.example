DATABASE_URL="file:./dev.db"
# 서버 포트 / 바인드 주소 (폰 접속을 위해 0.0.0.0)
PORT=3000
HOST=0.0.0.0
# 실제 ATEM 스위처 IP. 비우면 연결 시도 안 함. "mock" 이면 가상 ATEM 사용
ATEM_HOST=mock
# (선택) HTTPS 인증서 — 지정하면 폰 브라우저에서 Wake Lock API 사용 가능 (README 참고)
# TLS_CERT=./certs/cert.pem
# TLS_KEY=./certs/key.pem
# (선택) 제어할 M/E 버스 번호 (기본 1). Constellation 등 M/E 2 이상 모델용
# ATEM_ME=1
